{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://virtual-immersion.local/schema/interaction-state/v2",
  "title": "InteractionState v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "scenario_id", "conditions_sha256", "source_backend",
    "body0", "body1", "time_s", "sequence_id", "dt_s", "contact_present", "contact_mode",
    "coordinate_frame", "contact_centroid_world_m", "contact_centroid_local_m", "normal_world",
    "tangent_basis_world", "contact_point_count", "active_patch_count", "contact_area_proxy_m2",
    "physical_contact_area_m2", "normal_force_n", "tangent_force_world_n", "total_force_world_n",
    "normal_impulse_ns", "normal_relative_velocity_mps", "tangent_velocity_world_mps", "indentation_m",
    "penetration_m", "deformation_max_m", "deformation_mean_m", "deformation_rms_m", "deformation_field",
    "pressure_mean_pa", "pressure_peak_pa", "pressure_field", "quality", "confidence", "metadata"
  ],
  "properties": {
    "schema_version": {"const": "interaction-state/v2"},
    "run_id": {"type": "string", "minLength": 1},
    "scenario_id": {"type": "string", "minLength": 1},
    "conditions_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_backend": {"type": "string", "minLength": 1},
    "body0": {"type": "string", "minLength": 1},
    "body1": {"type": "string", "minLength": 1},
    "time_s": {"type": "number", "minimum": 0},
    "sequence_id": {"type": "integer", "minimum": 0},
    "dt_s": {"type": "number", "exclusiveMinimum": 0},
    "contact_present": {"type": "boolean"},
    "contact_mode": {"enum": ["no_contact", "approach", "loading", "hold", "sliding", "unloading", "unknown"]},
    "coordinate_frame": {"const": "world"},
    "contact_centroid_world_m": {"$ref": "#/$defs/vec3"},
    "contact_centroid_local_m": {"$ref": "#/$defs/vec3"},
    "normal_world": {"anyOf": [{"$ref": "#/$defs/vec3"}, {"type": "null"}]},
    "tangent_basis_world": {"type": "array", "prefixItems": [{"$ref": "#/$defs/vec3"}, {"$ref": "#/$defs/vec3"}], "minItems": 2, "maxItems": 2},
    "contact_point_count": {"type": "integer", "minimum": 0},
    "active_patch_count": {"type": "integer", "minimum": 0},
    "contact_area_proxy_m2": {"$ref": "#/$defs/nonnegativeOrNull"},
    "physical_contact_area_m2": {"$ref": "#/$defs/nonnegativeOrNull"},
    "normal_force_n": {"$ref": "#/$defs/nonnegativeOrNull"},
    "tangent_force_world_n": {"anyOf": [{"$ref": "#/$defs/vec3"}, {"type": "null"}]},
    "total_force_world_n": {"anyOf": [{"$ref": "#/$defs/vec3"}, {"type": "null"}]},
    "normal_impulse_ns": {"$ref": "#/$defs/nonnegativeOrNull"},
    "normal_relative_velocity_mps": {"$ref": "#/$defs/numberOrNull"},
    "tangent_velocity_world_mps": {"anyOf": [{"$ref": "#/$defs/vec3"}, {"type": "null"}]},
    "indentation_m": {"$ref": "#/$defs/nonnegativeOrNull"},
    "penetration_m": {"$ref": "#/$defs/nonnegativeOrNull"},
    "deformation_max_m": {"$ref": "#/$defs/nonnegativeOrNull"},
    "deformation_mean_m": {"$ref": "#/$defs/nonnegativeOrNull"},
    "deformation_rms_m": {"$ref": "#/$defs/nonnegativeOrNull"},
    "deformation_field": {"anyOf": [{"$ref": "#/$defs/spatialField"}, {"type": "null"}]},
    "pressure_mean_pa": {"$ref": "#/$defs/nonnegativeOrNull"},
    "pressure_peak_pa": {"$ref": "#/$defs/nonnegativeOrNull"},
    "pressure_field": {"anyOf": [{"$ref": "#/$defs/spatialField"}, {"type": "null"}]},
    "quality": {"type": "object", "additionalProperties": false, "required": ["contact", "contact_centroid_world_m", "normal_world", "tangent_force_world_n", "total_force_world_n", "tangent_velocity_world_mps", "contact_area_proxy_m2", "physical_contact_area_m2", "normal_force_n", "normal_impulse_ns", "normal_relative_velocity_mps", "indentation_m", "penetration_m", "deformation_max_m", "deformation_mean_m", "deformation_rms_m", "deformation_field", "pressure_mean_pa", "pressure_peak_pa", "pressure_field"], "properties": {"contact": {"$ref": "#/$defs/quality"}, "contact_centroid_world_m": {"$ref": "#/$defs/quality"}, "normal_world": {"$ref": "#/$defs/quality"}, "tangent_force_world_n": {"$ref": "#/$defs/quality"}, "total_force_world_n": {"$ref": "#/$defs/quality"}, "tangent_velocity_world_mps": {"$ref": "#/$defs/quality"}, "contact_area_proxy_m2": {"$ref": "#/$defs/quality"}, "physical_contact_area_m2": {"$ref": "#/$defs/quality"}, "normal_force_n": {"$ref": "#/$defs/quality"}, "normal_impulse_ns": {"$ref": "#/$defs/quality"}, "normal_relative_velocity_mps": {"$ref": "#/$defs/quality"}, "indentation_m": {"$ref": "#/$defs/quality"}, "penetration_m": {"$ref": "#/$defs/quality"}, "deformation_max_m": {"$ref": "#/$defs/quality"}, "deformation_mean_m": {"$ref": "#/$defs/quality"}, "deformation_rms_m": {"$ref": "#/$defs/quality"}, "deformation_field": {"$ref": "#/$defs/quality"}, "pressure_mean_pa": {"$ref": "#/$defs/quality"}, "pressure_peak_pa": {"$ref": "#/$defs/quality"}, "pressure_field": {"$ref": "#/$defs/quality"}}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "metadata": {"type": "object"}
  },
  "$defs": {
    "numberOrNull": {"anyOf": [{"type": "number"}, {"type": "null"}]},
    "nonnegativeOrNull": {"anyOf": [{"type": "number", "minimum": 0}, {"type": "null"}]},
    "vec3": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}], "minItems": 3, "maxItems": 3},
    "quality": {"type": "object", "additionalProperties": false, "required": ["status", "method", "unit", "source"], "properties": {"status": {"enum": ["measured", "estimated", "unavailable"]}, "method": {"type": "string", "minLength": 1}, "unit": {"type": "string", "minLength": 1}, "source": {"type": "string", "minLength": 1}}},
    "spatialField": {"type": "object", "additionalProperties": false, "required": ["values", "active_mask", "shape", "origin_local_m", "spacing_m", "basis_world", "units", "semantic"], "properties": {"values": {"type": "array"}, "active_mask": {"type": "array"}, "shape": {"type": "array", "prefixItems": [{"type": "integer", "minimum": 1}, {"type": "integer", "minimum": 1}], "minItems": 2, "maxItems": 2}, "origin_local_m": {"$ref": "#/$defs/vec3"}, "spacing_m": {"type": "array", "prefixItems": [{"type": "number", "exclusiveMinimum": 0}, {"type": "number", "exclusiveMinimum": 0}], "minItems": 2, "maxItems": 2}, "basis_world": {"type": "array", "prefixItems": [{"$ref": "#/$defs/vec3"}, {"$ref": "#/$defs/vec3"}, {"$ref": "#/$defs/vec3"}], "minItems": 3, "maxItems": 3}, "units": {"type": "string", "minLength": 1}, "semantic": {"enum": ["pressure", "deformation"]}}}
  }
}
